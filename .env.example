# 复制为 .env，先填写登录账号；没有默认密码。
NAST_USERNAME=admin
NAST_PASSWORD=
# 可选：桥接专用令牌，至少 32 字符；与 nast-bridges 的 BRIDGE_NAST_TOKEN 一致
NAST_BRIDGE_TOKEN=
# 可选：反向代理后的完整站点源，例如 https://chat.example.com
NAST_PUBLIC_ORIGIN=
# 仅 HTTPS 部署设为 true（本机 HTTP 保持 false）
NAST_COOKIE_SECURE=false

# nast 对外端口（宿主机侧）
NAST_PORT=8000

# 服务端 Lua 插件单次派发超时（秒）
NAST_PLUGIN_TIMEOUT_SECS=10
