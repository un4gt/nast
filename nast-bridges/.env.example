# 复制为 .env 后按需修改
# 公共
# 使用预构建镜像时设为 ghcr.io/un4gt/nast-bridges:latest
BRIDGE_IMAGE=nast-bridges:local
BRIDGE_NAST_SERVER=ws://nast:8000/ws
# 填写 nast 中配置的 NAST_BRIDGE_TOKEN；不是网页登录密码或 QQ 凭据
BRIDGE_NAST_TOKEN=
BRIDGE_AVATAR=
# QQ 单条分段长度（128–1500），不截断总回复；超出被动回复配额用 /more 查看
BRIDGE_MAX_CHARS=1500
# 生成超时（秒）：超时自动中止并回复错误，防止卡死后续消息
BRIDGE_GEN_TIMEOUT_SECS=240
# Discord（未实现，接入后生效）
DISCORD_TOKEN=
# 飞书（未实现，接入后生效）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
