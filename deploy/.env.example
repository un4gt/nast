# 仅拉取镜像；可替换为 sha-<完整提交 SHA> 标签或 @sha256:... 摘要。
NAST_IMAGE=ghcr.io/un4gt/nast:latest
BRIDGE_IMAGE=ghcr.io/un4gt/nast-bridges:latest

# 必填。密码中的 $ 或 # 使用单引号包裹整个值。
NAST_USERNAME=admin
NAST_PASSWORD=

# HTTPS 配好之前保持为空 / false。
NAST_PUBLIC_ORIGIN=
NAST_COOKIE_SECURE=false

# 默认仅宿主机可访问，由宿主机 Nginx 代理；不需要开放公网 8000。
NAST_HTTP_BIND=127.0.0.1
NAST_HTTP_PORT=8000

# 仅网页留空；接 QQ 时填 qq，并用 openssl rand -hex 32 生成令牌。
COMPOSE_PROFILES=
NAST_BRIDGE_TOKEN=
BRIDGE_AVATAR=
BRIDGE_MAX_CHARS=1500
BRIDGE_GEN_TIMEOUT_SECS=240

# 数据卷名称；迁移已有部署时填写原卷名，切勿误用空卷。
NAST_DATA_VOLUME=nast_nast-data
QQ_DATA_VOLUME=nast_qq-creds
